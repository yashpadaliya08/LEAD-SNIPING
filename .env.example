# Telegram Bot Configuration
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get chat id from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_chat_id_here

# Polling Interval (in milliseconds)
POLL_INTERVAL_MS=45000

# Rate Limiter: Maximum alerts sent to Telegram per hour
MAX_ALERTS_PER_HOUR=10

# Budget Thresholds
MIN_HOURLY_RATE=30
MIN_FIXED_BUDGET=200

# Freelancer Profile
FREELANCER_NAME=Partner
FREELANCER_TITLE=Rapid MVP & Automation Engineer
FREELANCER_CORE_SKILLS=Next.js, React, Node.js, Python, Web Scraping, AI Automation, APIs, Supabase

# Optional LLM API Keys (for custom fine-tuned LLM outputs)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
